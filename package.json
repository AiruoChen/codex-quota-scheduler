{
  "name": "codex-quota-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Modular local Codex quota monitor and task scheduler",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
